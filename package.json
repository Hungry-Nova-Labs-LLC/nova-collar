{
  "name": "nova-collar",
  "version": "0.6.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Nova Collar \u2014 Hungry Nova Labs agent window: chat, terminal, this system",
  "type": "module",
  "main": "src/main/index.js",
  "bin": {
    "nova-collar": "src/cli/np.js"
  },
  "scripts": {
    "postinstall": "node scripts/vendor-xterm.js && node scripts/rebuild-pty.js && node scripts/build-mac-control.js",
    "build:mac": "node scripts/build-mac-control.js",
    "rebuild": "node scripts/rebuild-pty.js",
    "icon": "python3 scripts/make-icon.py",
    "tentacle": "node src/main/tentacle/server.js",
    "test:tentacle": "node scripts/test-tentacle.mjs",
    "start": "node scripts/vendor-xterm.js && node scripts/build-mac-control.js && electron .",
    "setup": "node src/cli/np.js install",
    "np": "node src/cli/np.js",
    "pack": "node scripts/vendor-xterm.js && node scripts/build-mac-control.js && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --publish never",
    "release": "node scripts/release-mac.cjs",
    "release:win": "node scripts/vendor-xterm.js && electron-builder --win nsis zip --x64 --publish never -c.npmRebuild=false",
    "release:linux": "node scripts/vendor-xterm.js && electron-builder --linux AppImage deb --x64 --publish never",
    "test": "node scripts/test.mjs",
    "test:app": "node scripts/vendor-xterm.js && electron scripts/test-app.mjs && node scripts/test-first-launch-app.mjs",
    "analysis:prepare": "node scripts/prepare-analysis.mjs",
    "test:analysis": "node --test scripts/test-analysis.mjs",
    "test:analysis:live": "node scripts/verify-analysis-live.mjs",
    "test:network": "node --test scripts/test-network.mjs",
    "network:mcp": "node src/main/network-mcp.js",
    "evaluate:harness": "node scripts/evaluate-harness.mjs",
    "test:conversation": "electron scripts/test-conversation-app.mjs",
    "test:conversation:main": "electron scripts/test-conversation-main.mjs",
    "test:first-launch:app": "node scripts/vendor-xterm.js && node scripts/test-first-launch-app.mjs"
  },
  "author": "Hungry Nova Labs LLC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "acorn": "8.19.0",
    "electron-updater": "^6.8.9",
    "eslint-scope": "8.4.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "electron": "45.3.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.hungrynova.novapup",
    "productName": "Nova Collar",
    "afterSign": "scripts/notarize.cjs",
    "afterAllArtifactBuild": "scripts/notarize-dmg.cjs",
    "artifactName": "Nova-Collar-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Hungry-Nova-Labs-LLC",
      "repo": "nova-collar"
    },
    "files": [
      "src/**/*",
      "data/**/*",
      "materials/**/*",
      "package.json",
      "LICENSE",
      "NOTICE",
      "!src/**/* [0-9]*",
      "!data/**/* [0-9]*",
      "!materials/**/* [0-9]*"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "scripts/laya_np.py",
        "to": "laya_np.py"
      },
      {
        "from": "data/laya-np-question.json",
        "to": "laya-np-question.json"
      },
      {
        "from": "data/laya-np-loop.json",
        "to": "laya-np-loop.json"
      },
      {
        "from": "data/laya-np-goal.json",
        "to": "laya-np-goal.json"
      },
      {
        "from": "data/laya-np-audit.json",
        "to": "laya-np-audit.json"
      },
      {
        "from": "vendor/analysis/${os}-${arch}",
        "to": "analysis"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "bin/mac-control",
          "to": "mac-control"
        }
      ],
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleDisplayName": "Nova Collar",
        "CFBundleName": "Nova Collar"
      },
      "minimumSystemVersion": "13.5",
      "notarize": false,
      "sign": "scripts/sign-mac-code.cjs"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "Hungry Nova Labs LLC <noreply@hungrynovalabs.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "beforePack": "scripts/analysis-before-pack.cjs",
    "afterPack": "scripts/prepare-mac-release.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "novaCollarChannel": "public",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hungry-Nova-Labs-LLC/nova-collar.git"
  },
  "homepage": "https://github.com/Hungry-Nova-Labs-LLC/nova-collar#readme",
  "bugs": {
    "url": "https://github.com/Hungry-Nova-Labs-LLC/nova-collar/issues"
  }
}
